{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-checkin",
	"compatibility_date": "2026-10-23",
	"main": "./workers/app.ts",
	"workers_dev": true,
	"observability": { "enabled": true },
	"triggers": {
		// One hourly run; scheduled() decides which jobs are due (empty for now).
		"crons": ["0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "daily-checkin",
			"database_id": "f91151c9-b826-4512-a7f8-bc45ee67b2de",
			"migrations_dir": "migrations"
		}
	]
}
