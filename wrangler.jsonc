{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-checkin",
	"compatibility_date": "2026-10-23",
	"main": "./workers/app.ts",
	"workers_dev": true,
	"observability": {
		"enabled": true,
		// Invocation logs record each request URL, and /invite/<token> and
		// /setup/<token> carry raw link tokens. Turn them off; the app's own
		// console logs stay in Workers Logs.
		"logs": { "invocation_logs": false }
	},
	"vars": {
		// Iterations for new password hashes (each hash keeps its own count).
		// 100000 is the Workers maximum. Lower it if the smoke login hits the
		// Workers Free CPU limit; existing passwords keep working.
		"PBKDF2_ITERATIONS": "100000"
	},
	"triggers": {
		// One hourly run; scheduled() decides which jobs are due (empty for now).
		"crons": ["0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "daily-checkin",
			"database_id": "f91151c9-b826-4512-a7f8-bc45ee67b2de",
			"migrations_dir": "migrations"
		}
	]
}
