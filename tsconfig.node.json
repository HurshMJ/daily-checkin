{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "scripts/**/*",
    "app/auth/crypto.ts",
    "app/auth/setup-link-sql.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
